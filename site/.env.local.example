# Copie este arquivo pra .env.local (não versionado) e preencha antes de rodar.

# Senha de acesso à área do dono (/admin). Troque pra uma senha de verdade.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado pra assinar a sessão do dono depois do login. Qualquer texto
# longo e aleatório serve — troque também.
SESSION_SECRET=troque-este-segredo-tambem
